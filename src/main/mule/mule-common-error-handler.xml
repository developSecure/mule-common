<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<error-handler name="global-error-handler" doc:id="2d80a275-ceb2-438b-8dd9-9b883c55f390" >
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="cbd47150-1d8a-4a60-b5bc-52323c6378b0" type="ANY">
			<set-variable value="500" doc:name="httpStatus" doc:id="fcc67f49-151c-4a3c-8bbf-0c7e3094a53c" variableName="httpStatus"/>
			<ee:transform doc:name="response" doc:id="1ef820e3-6170-42de-92df-e86935256de5">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
import * from modules::errorUtils
output application/json
---
buildErrorResponse(error)]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<set-variable value="true" doc:name="isError" doc:id="3d5ae835-8e17-4ae5-8d5d-bb62043985f0" variableName="isError"/>
			<set-variable value='#[%dw 2.0
output application/json
---
{
	flow: (error.failingComponent default "" splitBy("/"))[0],
	"mule-config-file": (error.failingComponent splitBy(/ /))[2],
	failingComponent: ((error.dslSource splitBy(/&lt;| /)) filter $ != "")[0],
	failingAPI: ((error.failingComponent splitBy(/ /))[2] splitBy(/:/))[0]
}]' doc:name="logMessage" doc:id="1d3fdbd8-2496-4c3d-b899-700f345ca5ba" variableName="logMessage"/>
			<flow-ref doc:name="commonLoggingSubFlow" doc:id="75e19567-8b08-4c14-bea4-25577ea9d1a4" name="commonLoggingSubFlow"/>
		</on-error-continue>
	</error-handler>
</mule>
